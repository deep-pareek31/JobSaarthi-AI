# ==============================================================================
# JobSaarthi Production & Development Environment Configuration
# ==============================================================================
# In Google AI Studio, uncommented variables here trigger the platform modal
# "Enter your environment variable to continue".
# All client keys below are optional: the Android app functions fully offline
# and with free public job sources without requiring any secret keys.
# When deploying your own backend, you can configure these in the AI Studio Secrets panel.

# --- Optional Android Client Keys ---
# API_BASE_URL=http://10.0.2.2:8000/api/v1/
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GEMINI_API_KEY=

# --- Optional Backend Server Variables (For live FastAPI/PostgreSQL deployment) ---
# APP_NAME=JobSaarthi
# APP_ENV=development
# APP_DEBUG=true
# PORT=8000
# HOST=0.0.0.0
# API_V1_PREFIX=/api/v1
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://10.0.2.2:8000
# DATABASE_URL=postgresql+psycopg2://jobsaarthi:jobsaarthi_secure_pass@localhost:5432/jobsaarthi_db
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=10
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
# JWT_SECRET=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=30
# BCRYPT_ROUNDS=12
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# SUPERADMIN_EMAIL=admin@jobsaarthi.com
# SUPERADMIN_PASSWORD=ChangeMeInProduction_StrongP@ss2026!
# STORAGE_PROVIDER=local
# STORAGE_BUCKET=jobsaarthi-resumes
# STORAGE_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=dummy_aws_access_key
# AWS_SECRET_ACCESS_KEY=dummy_aws_secret_key
# FIREBASE_CREDENTIALS_PATH=./firebase_service_account.json
# INGESTION_DEFAULT_RATE_LIMIT_PER_MINUTE=30
# EXPIRATION_CHECK_HOURLY_CRON=0 * * * *
# FULL_CONSISTENCY_DAILY_CRON=0 2 * * *
